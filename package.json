{
  "name": "trenirovki",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:api": "tsx watch --env-file=.env scripts/dev-api.ts",
    "build": "tsc -b && tsc -p api/tsconfig.json && vite build",
    "preview": "vite preview --host",
    "shot": "node --env-file-if-exists=.env scripts/shot.mjs",
    "test:sync": "tsx --env-file=.env scripts/test-sync.ts",
    "test:e2e": "node --env-file=.env scripts/e2e.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "dexie": "^4.4.5",
    "drizzle-orm": "^0.45.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.4.1",
    "@vercel/node": "^12.0.0",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.62.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
