# Скопировать в .env и заполнить. .env в гите не лежит.
# Те же значения — в Vercel → Project → Settings → Environment Variables.
# Всё это — только сервер (API-функции). В браузерный бандл не попадает.

# Neon → Dashboard → Connection string (pooled, для serverless)
DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Код доступа к API. Длинная случайная строка, придумать самому:
#   node -e "console.log(crypto.randomUUID().replace(/-/g,'')+crypto.randomUUID().replace(/-/g,''))"
# Вводится в приложении один раз, дальше хранится в браузере. В бандле его нет.
APP_TOKEN=
